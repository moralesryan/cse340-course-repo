<%- include('partials/header', { title: project.title }) %>
    <main>
        <h1>
            <%= project.title %>
        </h1>

        <p>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' })
                %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <p class="section-label">Categories</p>
        <ul class="chip-list">
            <% categories.forEach(function(category) { %>
                <li>
                    <a class="chip" href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                </li>
                <% }) %>
        </ul>

        <% if (user) { %>
            <div class="volunteer-box">
                <% if (isVolunteering) { %>
                    <p class="volunteer-status">✓ You are volunteering for this project</p>
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                        <button type="submit" class="btn btn-outline">Remove me as a volunteer</button>
                    </form>
                    <% } else { %>
                        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                            <button type="submit" class="btn">Volunteer for this project</button>
                        </form>
                        <% } %>
            </div>
            <% } %>

                <% if (user && user.role_name==='admin' ) { %>
                    <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
                    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
                    <% } %>
    </main>

    <%- include('partials/footer') %>