<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Explore our service categories:</p>
        <ul class="chip-list">
            <% categories.forEach(function(category) { %>
                <li class="chip">
                    <%= category.category_name %>
                </li>
                <% }) %>
        </ul>
    </main>

    <%- include('partials/footer') %>