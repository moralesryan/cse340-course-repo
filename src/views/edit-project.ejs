<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
            <div class="form-group">
                <label for="name">Project Name</label>
                <input type="text" id="name" name="title" value="<%= projectDetails.title %>" required maxlength="150" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required
                    maxlength="500"><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <textarea type="text" id="location" name="location"<%= projectDetails.location %> required
                    maxlength="500"></textarea>
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required value="<%= projectDetails.date %>" />
            </div>

            <div class="form-group">
                <label for="organization_id">Organization</label>
                <select id="organization_id" name="organization_id" required>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>"
                            <%=org.organization_id===projectDetails.organization_id ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <button type="submit">Update Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>