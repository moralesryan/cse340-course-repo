<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="table-wrapper">

            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email (Username)</th>
                        <th>Role</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user=> { %>
                        <tr>
                            <td>
                                <%= user.name %>
                            </td>
                            <td>
                                <%= user.email %>
                            </td>
                            <td>
                                <%= user.role_name %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </main>
    <%- include('partials/footer') %>