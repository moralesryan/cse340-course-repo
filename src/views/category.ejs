<%- include('partials/header', { title: category.category_name }) %>

    <main>
        <div class="category-hero">
            <span class="badge">Category</span>
        </div>
        <h1>
            <%= category.category_name %>
        </h1>
        <p>Service projects in this category:</p>
        <ul class="chip-list">
            <% projects.forEach(function(project) { %>
                <li>
                    <a class="chip" href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
                <% }) %>
        </ul>

        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/edit-category/<%= category.category_id %>">Edit Category</a>
                <% } %>
        </p>
    </main>

    <%- include('partials/footer') %>